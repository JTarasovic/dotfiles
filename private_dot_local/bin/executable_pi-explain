#!/usr/bin/env bash
# Simple wrapper around `pi` using the freerouter strategy for low‑context queries.
# Usage: pi-explain [options] <prompt>
# Example: pi-explain "What does the field 'user_id' represent?"
#
# The script forwards the prompt directly to the LLM via pi-freerouter without
# including surrounding source code or traces. This is useful for quick
# look‑ups of symbols, comments, or function signatures.

# Default model; can be overridden with --model
MODEL="auto"
# Table of free-routers allowed: change if you want a different router
ROUTER="free-router"

# Parse options
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h | --help)
            cat << EOF
$(basename "$0") [options] <prompt>

Options:
  -m, --model <model>   Set the LLM model (default: $MODEL)
  -h, --help            Show this help message

The prompt is sent to the LLM via the freerouter strategy, which omits
surrounding context, yielding a lightweight, fast reply suitable for quick
symbol or comment explanations.
EOF
            exit 0
            ;;
        -m | --model)
            MODEL="$2"
            shift 2
            ;;
        *)
            # Remaining arguments form the prompt
            PROMPT="$*
"
            break
            ;;
    esac
done

if [[ -z $PROMPT ]]; then
    echo "Error: no prompt provided" >&2
    exit 1
fi

# Invoke pi using the freerouter strategy. We use the `-c` flag to set the
# strategy, and `-m` to set the model. The prompt is passed via stdin.
# `pi` will automatically pick the freerouter if available.

cat << EOF | pi --provider "$ROUTER" --model "$MODEL" --print --no-session --no-tools --no-themes --no-context-files -e "npm:pi-freerouter"
$PROMPT
EOF
